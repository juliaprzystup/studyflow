# Usluga systemd dla aplikacji StudyFlow (Gunicorn).
# Skopiuj na serwerze do: /etc/systemd/system/studyflow.service
# Zaktualizuj sciezki i SECRET_KEY zgodnie z DEPLOY.md.

[Unit]
Description=StudyFlow - Gunicorn (Flask)
After=network.target

[Service]
User=studyflow
Group=www-data
WorkingDirectory=/home/studyflow/fiszki_app

# WAZNE: ustaw wlasny, dlugi, losowy klucz (np. wynik: python3 -c "import secrets;print(secrets.token_hex(32))").
# Stala wartosc sprawia, ze sesje uzytkownikow przetrwaja restart serwera.
Environment="SECRET_KEY=ZMIEN_TEN_KLUCZ_NA_DLUGI_LOSOWY_CIAG"
Environment="PATH=/home/studyflow/fiszki_app/.venv/bin"

ExecStart=/home/studyflow/fiszki_app/.venv/bin/gunicorn -c gunicorn.conf.py wsgi:app

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
